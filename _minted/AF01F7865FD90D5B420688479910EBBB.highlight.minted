                \PYG{c+c1}{\PYGZsh{} Y = [y, y\PYGZsq{}, y\PYGZsq{}\PYGZsq{}, ..., y\PYGZca{}\PYGZob{}(n\PYGZhy{}1)\PYGZcb{}]}
